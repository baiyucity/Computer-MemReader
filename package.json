{
  "name": "memreader",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A beautiful local Windows disk space explorer",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:native": "node scripts/native-smoke.cjs",
    "build:launcher": "node scripts/build-launcher.cjs",
    "pack": "pnpm build && electron-builder --win dir --publish never",
    "dist": "pnpm build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.memreader.desktop",
    "productName": "Memreader",
    "afterPack": "scripts/after-pack.cjs",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
